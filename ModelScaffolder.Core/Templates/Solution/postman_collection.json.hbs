{
  "info": {
    "name": "{{project.name}} API",
    "description": "Generated by ModelScaffolder. Set the 'password' collection variable to the system user's password, start the APIs, then run the collection (folders run in order: create, read, update, negative, delete).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{pm "username"}}", "type": "string" },
      { "key": "password", "value": "{{pm "password"}}", "type": "string" }
    ]
  },
  "variable": [
{{#each schemas}}
    { "key": "{{camelName}}BaseUrl", "value": "http://localhost:{{port}}" },
{{#each entities}}
    { "key": "{{idVariable}}", "value": "" },
{{/each}}
{{/each}}
    { "key": "username", "value": {{json project.systemUserName}} },
    { "key": "password", "value": "" }
  ],
  "item": [
{{#each schemas}}
    {
      "name": "{{name}}",
      "item": [
        {
          "name": "1. Create",
          "item": [
{{#each entitiesInDependencyOrder}}
            {
              "name": "Create {{name}}",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('201 Created', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('{{idVariable}}', pm.response.json().{{key.camelName}});"
              ] } }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": {{json sampleCreateBody}}, "options": { "raw": { "language": "json" } } },
                "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}"
              }
            }{{#unless @last}},{{/unless}}
{{/each}}
          ]
        },
        {
          "name": "2. Read",
          "item": [
{{#each entities}}
            {
              "name": "List {{plural}}",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "pm.test('returns an array', () => pm.expect(pm.response.json()).to.be.an('array'));"
              ] } }],
              "request": { "method": "GET", "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}" }
            },
            {
              "name": "List {{plural}} sorted by {{sortSample}} (desc)",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));"
              ] } }],
              "request": { "method": "GET", "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}?sortBy={{sortSample}}&order=Desc" }
            },
            {
              "name": "Get {{name}} by id",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));",
                "pm.test('returns the created item', () => pm.expect(String(pm.response.json().{{key.camelName}})).to.eql(String(pm.collectionVariables.get('{{idVariable}}'))));"
              ] } }],
              "request": { "method": "GET", "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}/{{pm idVariable}}" }
            }{{#unless @last}},{{/unless}}
{{/each}}
          ]
        },
        {
          "name": "3. Update",
          "item": [
{{#each entities}}
            {
              "name": "Update {{name}}",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('200 OK', () => pm.response.to.have.status(200));"
              ] } }],
              "request": {
                "method": "PUT",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": {{json sampleUpdateBody}}, "options": { "raw": { "language": "json" } } },
                "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}/{{pm idVariable}}"
              }
            }{{#unless @last}},{{/unless}}
{{/each}}
          ]
        },
        {
          "name": "4. Negative",
          "item": [
{{#each entities}}
{{#if createRules}}
            {
              "name": "Create {{name}} with invalid body -> 422",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('422 Unprocessable Entity', () => pm.response.to.have.status(422));",
                "pm.test('lists validation errors', () => pm.expect(pm.response.json().errors).to.be.an('object'));"
              ] } }],
              "request": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": { "mode": "raw", "raw": "{}", "options": { "raw": { "language": "json" } } },
                "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}"
              }
            },
{{/if}}
            {
              "name": "List {{plural}} without credentials -> 401",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
              ] } }],
              "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}" }
            },
            {
              "name": "List {{plural}} with unknown sort field -> 400",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
              ] } }],
              "request": { "method": "GET", "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}?sortBy=doesNotExist" }
            }{{#unless @last}},{{/unless}}
{{/each}}
          ]
        },
        {
          "name": "5. Delete",
          "item": [
{{#each entitiesInReverseDependencyOrder}}
            {
              "name": "Delete {{name}}",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('204 No Content', () => pm.response.to.have.status(204));"
              ] } }],
              "request": { "method": "DELETE", "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}/{{pm idVariable}}" }
            },
            {
              "name": "Get deleted {{name}} -> 404",
              "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
                "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
              ] } }],
              "request": { "method": "GET", "url": "{{pm ../camelName "BaseUrl"}}/api/{{route}}/{{pm idVariable}}" }
            }{{#unless @last}},{{/unless}}
{{/each}}
          ]
        }
      ]
    }{{#unless @last}},{{/unless}}
{{/each}}
  ]
}
