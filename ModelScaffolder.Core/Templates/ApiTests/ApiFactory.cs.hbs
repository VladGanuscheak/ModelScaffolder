using System.Net.Http.Headers;
using System.Text;
using Authentication.Basic;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Mvc.Testing;
using Testcontainers.PostgreSql;
using {{schema.namespace}}.Infrastructure;
using {{schema.namespace}}.Policies;
using {{schema.namespace}}.Policies.Permissions;

namespace {{schema.namespace}}.Api.Tests;

/// <summary>
///     Hosts the real {{schema.name}} API in memory (authentication, RePolicies, ReValidator, EF Core) against a throwaway
///     PostgreSQL container. Requires Docker. Shared by all tests in <see cref="ApiCollection"/>.
/// </summary>
public sealed class ApiFactory : WebApplicationFactory<Program>, IAsyncLifetime
{
    public const string AdminUser = "test-admin";
    public const string ReadOnlyUser = "test-reader";
    public const string Password = "Integration-Tests-1!";

    private readonly PostgreSqlContainer _database = new PostgreSqlBuilder()
        .WithImage("postgres:17-alpine")
        .Build();

    /// <summary>A client that sends Basic credentials for <paramref name="userName"/>.</summary>
    public HttpClient CreateClientFor(string userName, string password = Password)
    {
        var client = CreateClient();
        client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue(
            BasicAuthenticationDefaults.SchemeName,
            Convert.ToBase64String(Encoding.UTF8.GetBytes($"{userName}:{password}")));
        return client;
    }

    protected override void ConfigureWebHost(IWebHostBuilder builder)
    {
        builder.UseEnvironment("Testing");
        builder.UseSetting("ConnectionStrings:Default", _database.GetConnectionString());

        // Replace the configured users: an admin with every permission and a reader with Get permissions only.
        AddUser(builder, 0, AdminUser, {{schema.name}}Permissions.All);
        AddUser(builder, 1, ReadOnlyUser, [{{#each schema.entities}}{{name}}Permissions.Get{{#unless @last}}, {{/unless}}{{/each}}]);
    }

    public async Task InitializeAsync()
    {
        await _database.StartAsync();
        await Services.EnsureDatabaseCreatedAsync();
    }

    async Task IAsyncLifetime.DisposeAsync()
    {
        await base.DisposeAsync();
        await _database.DisposeAsync();
    }

    private static void AddUser(IWebHostBuilder builder, int index, string userName, IReadOnlyList<string> permissions)
    {
        var prefix = $"{UserStoreOptions.SectionName}:{nameof(UserStoreOptions.Users)}:{index}:";
        builder.UseSetting(prefix + nameof(UserAccount.UserName), userName);
        builder.UseSetting(prefix + nameof(UserAccount.PasswordHash), PasswordHash.Create(Password, iterations: 1_000)); // fast hash for tests

        for (var i = 0; i < permissions.Count; i++)
            builder.UseSetting($"{prefix}{nameof(UserAccount.Permissions)}:{i}", permissions[i]);
    }
}

[CollectionDefinition(nameof(ApiCollection))]
public sealed class ApiCollection : ICollectionFixture<ApiFactory>
{
}
