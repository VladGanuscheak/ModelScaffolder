<Project Sdk="Microsoft.NET.Sdk">

  <!--
    netstandard2.0 so the library can also be loaded in-process by the VSIX (net472) if ever needed.
    The recommended path is still: VSIX -> ModelScaffolder.Cli (separate process) -> this library.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>ModelScaffolder.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Handlebars.Net" Version="2.1.6" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <!-- Templates are plain files copied next to the binaries so they can be edited or overridden with the CLI templates option. -->
  <ItemGroup>
    <None Include="Templates\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
