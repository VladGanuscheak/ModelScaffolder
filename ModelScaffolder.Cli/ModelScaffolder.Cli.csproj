<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>modelscaffold</AssemblyName>
    <RootNamespace>ModelScaffolder.Cli</RootNamespace>

    <!-- Install as a global tool: dotnet tool install, global, from the ./nupkg source. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>modelscaffold</ToolCommandName>
    <PackageId>ModelScaffolder.Cli</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ModelScaffolder.Core\ModelScaffolder.Core.csproj" />
  </ItemGroup>

</Project>
